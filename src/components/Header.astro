---
import { licensePrograms, postgraduatePrograms } from '../data/site';
import type { Program } from '../data/site';

const sortPrograms = (items: Program[]) => [...items].sort((a, b) => a.title.localeCompare(b.title, 'es', { sensitivity: 'base' }));
const splitColumns = <T,>(items: T[], count: number) => {
  const base = Math.floor(items.length / count);
  const rest = items.length % count;
  let start = 0;
  return Array.from({ length: count }, (_, index) => {
    const length = base + (index < rest ? 1 : 0);
    const column = items.slice(start, start + length);
    start += length;
    return column;
  });
};

const licenciaturas = sortPrograms(licensePrograms);
const maestrias = sortPrograms(postgraduatePrograms.filter((program) => program.category === 'maestria'));
const doctorados = sortPrograms(postgraduatePrograms.filter((program) => program.category === 'doctorado'));
const licenciaturasColumnas = splitColumns(licenciaturas, 3);
const maestriasColumnas = splitColumns(maestrias, 2);
const menuLinks = [
  { label: 'Nosotros', href: '/nosotros/' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header>
  <div class="nav-shell">
    <div class="nav-row">
      <a class="logo" href="/" aria-label="Santander Live, inicio">
        <span class="logo-mark"><span class="brand-main"><small>Sistema</small><strong>Santander</strong><small>Live Streaming</small></span><span class="brand-rule" aria-hidden="true"></span><span class="brand-university"><strong>Universidad</strong><small>Autónoma de Durango</small></span></span>
      </a>

      <button id="hamburger" type="button" aria-label="Abrir menú principal" aria-controls="primary-navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="desktop-navigation" aria-label="Navegación principal">
        <ul class="menu-links">
          <li class="menu-item has-panel" data-menu="licenciaturas"><button class="menu-trigger" type="button" aria-expanded="false" aria-controls="panel-licenciaturas">Licenciaturas</button></li>
          <li class="menu-item has-panel" data-menu="posgrados"><button class="menu-trigger" type="button" aria-expanded="false" aria-controls="panel-posgrados">Posgrados</button></li>
          {menuLinks.map(({ label, href }) => <li class="menu-item"><a aria-current={Astro.url.pathname === href ? 'page' : undefined} href={href}>{label}</a></li>)}
          <li class="menu-action"><span class="button button--preinscription" title="Enlace de ingreso por definir">Ingresar</span></li>
        </ul>
      </nav>
    </div>

    <nav id="primary-navigation" class="mobile-navigation" aria-label="Navegación principal">
      <ul class="mobile-menu-links">
        <li class="mobile-menu-item has-mobile-submenu" data-mobile-menu="licenciaturas">
          <button class="mobile-menu-trigger" type="button" aria-expanded="false" aria-controls="mobile-panel-licenciaturas">Licenciaturas <span aria-hidden="true"></span></button>
          <div class="mobile-submenu" id="mobile-panel-licenciaturas"><ul class="mobile-program-list">{licenciaturas.map((program) => <li><a href={`/licenciaturas/${program.slug}`}>{program.title}</a></li>)}</ul></div>
        </li>
        <li class="mobile-menu-item has-mobile-submenu" data-mobile-menu="posgrados">
          <button class="mobile-menu-trigger" type="button" aria-expanded="false" aria-controls="mobile-panel-posgrados">Posgrados <span aria-hidden="true"></span></button>
          <div class="mobile-submenu" id="mobile-panel-posgrados">
            <section class="mobile-program-group" aria-labelledby="mobile-maestrias"><h2 id="mobile-maestrias">Maestrías</h2><ul class="mobile-program-list">{maestrias.map((program) => <li><a href={`/posgrados/${program.slug}`}>{program.title}</a></li>)}</ul></section>
            <section class="mobile-program-group" aria-labelledby="mobile-doctorados"><h2 id="mobile-doctorados">Doctorados</h2><ul class="mobile-program-list">{doctorados.map((program) => <li><a href={`/posgrados/${program.slug}`}>{program.title}</a></li>)}</ul></section>
          </div>
        </li>
        {menuLinks.map(({ label, href }) => <li class="mobile-menu-item"><a aria-current={Astro.url.pathname === href ? 'page' : undefined} href={href}>{label}</a></li>)}
        <li class="mobile-menu-actions"><span class="button button--preinscription" title="Enlace de ingreso por definir">Ingresar</span></li>
      </ul>
    </nav>

    <div class="mega-region">
      <section class="mega-panel" id="panel-licenciaturas" data-panel="licenciaturas" aria-label="Oferta de licenciaturas">
        <div class="mega-intro"><h2>Licenciaturas</h2><p>{licenciaturas.length} programas profesionales en modalidad Live Streaming.</p></div>
        <div class="program-columns" aria-label="Programas de licenciatura">{licenciaturasColumnas.map((column) => <ul>{column.map((program) => <li><a href={`/licenciaturas/${program.slug}`}>{program.title}</a></li>)}</ul>)}</div>
      </section>

      <section class="mega-panel" id="panel-posgrados" data-panel="posgrados" aria-label="Oferta de posgrados">
        <div class="mega-intro"><h2>Posgrados</h2><p>{maestrias.length + doctorados.length} programas de maestría y doctorado.</p></div>
        <div class="postgraduate-groups">
          <section class="program-group"><div class="group-heading"><h3>Maestrías</h3><span>{maestrias.length}</span></div><div class="program-columns two-columns">{maestriasColumnas.map((column) => <ul>{column.map((program) => <li><a href={`/posgrados/${program.slug}`}>{program.title}</a></li>)}</ul>)}</div></section>
          <section class="program-group doctorados-group"><div class="group-heading"><h3>Doctorados</h3><span>{doctorados.length}</span></div><ul>{doctorados.map((program) => <li><a href={`/posgrados/${program.slug}`}>{program.title}</a></li>)}</ul></section>
        </div>
      </section>
    </div>
  </div>
</header>

<style>
    header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 95;
        color: var(--gray-900);
        background: rgba(26, 26, 26, .88);
        overflow: hidden;
        -webkit-backdrop-filter: blur(0);
        backdrop-filter: blur(0);
        transition: height .42s cubic-bezier(.4, 0, .2, 1), transform .4s cubic-bezier(.4, 0, .2, 1), backdrop-filter .4s ease;
        will-change: height, transform;
    }

    header.scrolled,
    header.is-expanded { -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }

    .nav-shell { max-width: 1280px; margin: auto; padding: 14px 28px; }
    .nav-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .logo { line-height: 1; flex-shrink: 0; color: #fff; text-decoration: none; }
    .logo-mark { display: flex; align-items: center; gap: 9px; width: 310px; min-height: 50px; text-transform: uppercase; white-space: nowrap; }
    .brand-main, .brand-university { display: grid; gap: 2px; }
    .brand-main strong { font-family: Georgia, serif; font-size: 1.2rem; font-weight: 400; letter-spacing: .11em; }
    .brand-main small { font-size: .43rem; letter-spacing: .18em; }
    .brand-university strong { font-family: Georgia, serif; font-size: .94rem; font-weight: 400; }
    .brand-university small { font-size: .47rem; letter-spacing: .04em; }
    .brand-rule { height: 40px; border-left: 1px solid currentColor; }
    nav { margin-left: auto; }
    .menu-links { display: flex; align-items: center; gap: 20px; margin: 0; padding: 0; list-style: none; }
    .menu-item { display: flex; align-items: center; position: relative; }
    .menu-item > a,
    .menu-trigger,
    .button { color: var(--gray-900); font-weight: 600; text-decoration: none; white-space: nowrap; }
    .menu-item > a::after,
    .menu-trigger::before {
        content: '';
        position: absolute;
        right: 0;
        bottom: -10px;
        left: 0;
        height: 2px;
        background: var(--red-200);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform .28s ease;
    }
    .menu-item:hover > a::after,
    .menu-item:focus-within > a::after,
    .menu-item.open .menu-trigger::before { transform: scaleX(1); transform-origin: left; }
    .menu-item > a:hover,
    .menu-trigger:hover { color: white; }
    .menu-trigger { display: inline-flex; align-items: center; padding: 0; border: 0; background: transparent; cursor: pointer; position: relative; font-family: inherit; font-size: inherit; }
    .menu-action { display: flex; }
    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-height: 30px;
        padding: .38rem .9rem;
        border: 1px solid transparent;
        border-radius: 15px;
        font-size: var(--text-sm);
        line-height: 1;
        letter-spacing: .01em;
        transition: background-color .25s ease, border-color .25s ease, color .25s ease, transform .25s ease;
    }
    .button:hover { transform: translateY(-1px); }
    .button:focus-visible { outline: 2px solid white; outline-offset: 3px; }
    .button--preinscription { min-width: 90px; border-color: #d0444a; background: #c10230; color: white; }
    .button--preinscription:hover { border-color: #e1545d; background: var(--red-100); }
    .button--login { min-width: 102px; border-color: var(--gray-900); background: white; color: var(--gray-100); }
    .button--login:hover { background: var(--gray-900); }

    .mega-region { position: relative; height: 0; overflow: hidden; transition: height .42s cubic-bezier(.4, 0, .2, 1); }
    .mega-panel {
        position: absolute;
        inset: 0 0 auto;
        width: 100%;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(190px, .82fr) minmax(0, 2.45fr);
        gap: clamp(32px, 5vw, 84px);
        padding: 30px 0 18px;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-8px);
        transition: opacity .22s ease, transform .3s ease, visibility 0s linear .3s;
    }
    .mega-panel.is-current { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0); transition-delay: .08s, .08s, 0s; }
    .mega-panel.is-leaving { visibility: visible; opacity: 0; pointer-events: none; transform: translateY(5px); transition-delay: 0s; }
    .mega-intro { padding-right: 24px; border-right: 1px solid rgba(255, 255, 255, .16); }
    .mega-intro h2 { margin: 0; color: white; font-size: var(--text-xl); }
    .mega-intro > p { margin: 8px 0 0; color: var(--gray-500); font-size: var(--text-sm); line-height: 1.45; }
    .program-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3vw, 54px); }
    .program-columns ul, .program-group > ul { margin: 0; padding: 0; list-style: none; }
    .program-columns li, .program-group > ul li { margin-bottom: 9px; line-height: 1.28; }
    .program-columns a, .program-group > ul a { color: var(--gray-900); font-size: var(--text-sm); font-weight: 550; text-decoration: none; transition: color .2s ease; }
    .program-columns a:hover, .program-group li a:hover { color: var(--red-200); }
    .postgraduate-groups { display: grid; grid-template-columns: minmax(0, 2fr) minmax(190px, .8fr); gap: clamp(28px, 4vw, 70px); }
    .program-group + .program-group { padding-left: clamp(24px, 4vw, 58px); border-left: 1px solid rgba(255, 255, 255, .16); }
    #panel-posgrados { gap: clamp(32px, 3vw, 48px); }
    #panel-posgrados .postgraduate-groups { grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr); gap: clamp(28px, 3vw, 42px); }
    #panel-posgrados .program-group + .program-group { padding-left: clamp(24px, 2vw, 32px); }
    .group-heading { display: flex; align-items: baseline; gap: 8px; margin: 0 0 15px; }
    .group-heading h3 { margin: 0; color: white; font-size: var(--text-md); }
    .group-heading > span { color: var(--gray-400); font-size: var(--text-xs); }
    .two-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(22px, 3.5vw, 54px); }

    .mobile-navigation, #hamburger { display: none; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

    @media (max-width: 1180px) and (min-width: 900px) {
        .nav-shell { padding-inline: 20px; }
        .nav-row { gap: 20px; }
        .logo-mark { width: 245px; }
        .brand-main strong { font-size: 1.05rem; }
        .brand-university strong { font-size: .78rem; }
        .menu-links { gap: 12px; }
        .menu-item > a, .menu-trigger, .button { font-size: var(--text-xs); }
        .button { min-height: 28px; padding-inline: .65rem; }
        .button--preinscription { min-width: 84px; }
        .button--login { min-width: 88px; }
        .mega-panel { grid-template-columns: 195px minmax(0, 1fr); gap: 30px; }
        .program-columns { gap: 20px; }
    }

    @media (max-width: 899px) {
        header {
            overflow: hidden;
            background: rgba(18, 18, 18, .94);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
        }
        .nav-shell { min-height: 100%; padding: 12px 24px; }
        .nav-row { align-items: center; flex-wrap: nowrap; }
        .logo-mark { width: 245px; min-height: 45px; }
        #hamburger { display: flex; flex-direction: column; justify-content: space-between; width: 32px; height: 22px; margin: 0 1px 0 0; padding: 0; border: 0; background: transparent; cursor: pointer; }
        #hamburger span { width: 100%; height: 2px; border-radius: 999px; background: white; transition: transform .25s ease, opacity .25s ease; }
        header.mobile-open,
        header.mobile-closing { background: rgba(18, 18, 18, .96); }
        header.mobile-open { height: 100dvh; touch-action: none; }
        header.mobile-open #hamburger span:nth-child(1) { transform: translateY(10px) rotate(45deg); }
        header.mobile-open #hamburger span:nth-child(2) { opacity: 0; }
        header.mobile-open #hamburger span:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }
        .desktop-navigation, .mega-region { display: none; }

        .mobile-navigation {
            display: block;
            width: 100%;
            height: 0;
            min-height: 0;
            margin-top: 0;
            overflow: hidden;
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-12px);
            transition: opacity .24s ease, transform .32s cubic-bezier(.4, 0, .2, 1), visibility 0s linear .32s;
        }
        header.mobile-open .nav-shell,
        header.mobile-closing .nav-shell {
            display: flex;
            flex-direction: column;
            height: 100%;
            box-sizing: border-box;
        }
        header.mobile-open .mobile-navigation,
        header.mobile-closing .mobile-navigation {
            flex: 1;
            height: auto;
            margin-top: 38px;
            overflow-y: auto;
            overscroll-behavior: contain;
            touch-action: pan-y;
            visibility: visible;
            pointer-events: auto;
        }
        header.mobile-open .mobile-navigation {
            opacity: 1;
            transform: translateY(0);
            transition-delay: .08s, .08s, 0s;
        }
        header.mobile-closing .mobile-navigation {
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px);
        }
        .mobile-menu-links,
        .mobile-program-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }
        .mobile-menu-links { padding-bottom: 28px; }
        .mobile-menu-item { border-bottom: 1px solid rgba(255, 255, 255, .18); }
        .mobile-menu-item > a,
        .mobile-menu-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 0;
            border: 0;
            color: var(--gray-900);
            background: transparent;
            font-family: inherit;
            font-size: var(--text-lg);
            font-weight: 650;
            line-height: 1.25;
            text-align: left;
            text-decoration: none;
        }
        .mobile-menu-trigger { cursor: pointer; }
        .mobile-menu-trigger > span {
            width: 6px;
            height: 6px;
            margin: -4px 4px 0 16px;
            border-right: 1.5px solid currentColor;
            border-bottom: 1.5px solid currentColor;
            transform: rotate(45deg);
            transition: transform .25s ease, margin .25s ease;
        }
        .mobile-menu-item.is-open .mobile-menu-trigger > span { margin-top: 4px; transform: rotate(225deg); }
        .mobile-submenu {
            height: 0;
            overflow: hidden;
            opacity: 0;
            transform: translateY(-6px);
            transition: height .34s cubic-bezier(.4, 0, .2, 1), opacity .2s ease, transform .28s ease;
        }
        .mobile-menu-item.is-open .mobile-submenu { opacity: 1; transform: translateY(0); }
        .mobile-program-list { padding: 0 0 14px; }
        .mobile-program-list li + li { margin-top: 2px; }
        .mobile-program-list a {
            display: block;
            padding: 7px 0;
            color: var(--gray-800);
            font-size: var(--text-sm);
            font-weight: 550;
            line-height: 1.35;
            text-decoration: none;
        }
        .mobile-program-list a:hover,
        .mobile-program-list a:focus-visible { color: var(--red-200); }
        .mobile-program-group + .mobile-program-group {
            margin-top: 10px;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, .14);
        }
        .mobile-program-group h2 {
            margin: 0 0 8px;
            color: var(--red-200);
            font-size: var(--text-xs);
            font-weight: 750;
            letter-spacing: .12em;
            text-transform: uppercase;
        }
        .mobile-menu-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            padding-top: 24px;
        }
        .mobile-menu-actions .button { margin: 0; font-size: var(--text-base); }
    }

    @media (max-width: 480px) {
        .nav-shell { padding: 12px 20px; }
        .logo-mark { width: 210px; }
        .brand-university strong { font-size: .69rem; }
        .brand-university small { font-size: .4rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        header, .mega-region, .mega-panel, .mobile-navigation, .mobile-menu-trigger > span, .mobile-submenu { transition-duration: .01ms; }
    }

</style>

<script>
    const desktopBreakpoint = 899;
    const closeDelay = 150;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let navController: AbortController | undefined;
    let transitionToken = 0;
    let lastScrollY = 0;
    let headerHidden = false;

    function setupNav() {
        navController?.abort();
        navController = new AbortController();
        const { signal } = navController;
        const header = document.querySelector<HTMLElement>('header');
        const menuToggle = document.querySelector<HTMLButtonElement>('#hamburger');
        const menuItems = [...document.querySelectorAll<HTMLElement>('.desktop-navigation .has-panel')];
        const panels = [...document.querySelectorAll<HTMLElement>('.mega-panel')];
        const mobileMenuItems = [...document.querySelectorAll<HTMLElement>('.has-mobile-submenu')];
        const megaRegion = header?.querySelector<HTMLElement>('.mega-region');
        const navRow = header?.querySelector<HTMLElement>('.nav-row');
        const mobilePanelTokens = new WeakMap<HTMLElement, number>();
        let mobileTransitionToken = 0;
        let previousViewport = window.innerWidth > desktopBreakpoint;
        let clickOpenedPanel: string | undefined;

        if (!header || !menuToggle || !megaRegion || !navRow) return;

        const isDesktop = () => window.innerWidth > desktopBreakpoint;
        const getCurrentPanel = () => panels.find((panel) => panel.classList.contains('is-current'));
        const getPanel = (name: string) => panels.find((panel) => panel.dataset.panel === name);
        const getMobilePanel = (item: HTMLElement) => item.querySelector<HTMLElement>('.mobile-submenu');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const setMenuState = (name?: string) => {
            menuItems.forEach((item) => {
                const isOpen = item.dataset.menu === name;
                item.classList.toggle('open', isOpen);
                item.querySelector<HTMLButtonElement>('.menu-trigger')?.setAttribute('aria-expanded', String(isOpen));
            });
        };

        const settleTransition = (token: number) => {
            if (token !== transitionToken) return;
            header.style.height = 'auto';
            panels.forEach((panel) => {
                if (!panel.classList.contains('is-current')) panel.classList.remove('is-leaving');
            });
        };

        const animateDesktop = (nextName?: string) => {
            const nextPanel = nextName ? getPanel(nextName) : undefined;
            const currentPanel = getCurrentPanel();

            if (nextPanel === currentPanel) return;

            window.clearTimeout(closeTimer);
            header.style.transform = 'translateY(0)';
            headerHidden = false;

            const token = ++transitionToken;
            const fromHeight = header.getBoundingClientRect().height;
            header.style.height = `${fromHeight}px`;

            if (currentPanel) {
                currentPanel.classList.remove('is-current');
                currentPanel.classList.add('is-leaving');
            }

            if (nextPanel) {
                nextPanel.classList.remove('is-leaving');
                nextPanel.classList.add('is-current');
                megaRegion.style.height = `${nextPanel.scrollHeight}px`;
                header.classList.add('is-expanded');
            } else {
                megaRegion.style.height = '0px';
                header.classList.remove('is-expanded');
            }

            setMenuState(nextName);
            const targetHeight = header.scrollHeight;
            header.getBoundingClientRect();
            requestAnimationFrame(() => { if (token === transitionToken) header.style.height = `${targetHeight}px`; });

            if (Math.abs(fromHeight - targetHeight) < 1) {
                requestAnimationFrame(() => settleTransition(token));
                return;
            }

            const onTransitionEnd = (event: TransitionEvent) => {
                if (event.propertyName !== 'height') return;
                header.removeEventListener('transitionend', onTransitionEnd);
                settleTransition(token);
            };

            header.addEventListener('transitionend', onTransitionEnd);
        };

        const openPanel = (name: string) => {
            if (!isDesktop()) return;
            clickOpenedPanel = undefined;
            animateDesktop(name);
        };

        const closePanel = () => {
            clickOpenedPanel = undefined;
            if (isDesktop()) animateDesktop();
        };

        const scheduleClose = () => {
            if (!isDesktop() || clickOpenedPanel) return;
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(closePanel, closeDelay);
        };

        menuItems.forEach((item) => {
            const trigger = item.querySelector<HTMLButtonElement>('.menu-trigger');
            const name = item.dataset.menu!;
            item.addEventListener('pointerenter', (event) => {
                if (event.pointerType === 'mouse' && isDesktop()) openPanel(name);
            }, { signal });
            item.addEventListener('pointerleave', (event) => {
                if (event.pointerType === 'mouse') scheduleClose();
            }, { signal });
            item.addEventListener('focusin', () => { if (isDesktop()) openPanel(name); }, { signal });
            trigger?.addEventListener('click', () => {
                if (!isDesktop()) return;

                const isCurrentPanel = getCurrentPanel()?.dataset.panel === name;
                if (isCurrentPanel && clickOpenedPanel === name) {
                    closePanel();
                    return;
                }

                clickOpenedPanel = name;
                animateDesktop(name);
            }, { signal });
        });

        megaRegion.addEventListener('pointerenter', (event) => {
            if (event.pointerType === 'mouse') window.clearTimeout(closeTimer);
        }, { signal });
        megaRegion.addEventListener('pointerleave', (event) => {
            if (event.pointerType === 'mouse') scheduleClose();
        }, { signal });
        document.addEventListener('pointerdown', (event) => {
            if (isDesktop() && !header.contains(event.target as Node)) closePanel();
        }, { signal });

        const resetMobilePanels = () => {
            mobileMenuItems.forEach((item) => {
                item.classList.remove('is-open');
                item.querySelector<HTMLButtonElement>('.mobile-menu-trigger')?.setAttribute('aria-expanded', 'false');
                const panel = getMobilePanel(item);
                if (panel) panel.style.height = '';
            });
        };

        const animateMobilePanel = (item: HTMLElement, open: boolean, immediate = false) => {
            const panel = getMobilePanel(item);
            const trigger = item.querySelector<HTMLButtonElement>('.mobile-menu-trigger');
            if (!panel || !trigger) return;

            const token = (mobilePanelTokens.get(panel) ?? 0) + 1;
            mobilePanelTokens.set(panel, token);
            const startHeight = panel.getBoundingClientRect().height;
            item.classList.toggle('is-open', open);
            trigger.setAttribute('aria-expanded', String(open));

            if (immediate || reducedMotion) {
                panel.style.height = open ? 'auto' : '';
                return;
            }

            const endHeight = open ? panel.scrollHeight : 0;
            panel.style.height = `${startHeight}px`;
            panel.getBoundingClientRect();
            requestAnimationFrame(() => {
                if (mobilePanelTokens.get(panel) === token) panel.style.height = `${endHeight}px`;
            });

            const onTransitionEnd = (event: TransitionEvent) => {
                if (event.target !== panel || event.propertyName !== 'height' || mobilePanelTokens.get(panel) !== token) return;
                panel.removeEventListener('transitionend', onTransitionEnd);
                panel.style.height = open ? 'auto' : '';
            };
            panel.addEventListener('transitionend', onTransitionEnd);
        };

        const setMobilePanel = (name?: string, immediate = false) => {
            mobileMenuItems.forEach((item) => {
                const shouldOpen = item.dataset.mobileMenu === name;
                if (item.classList.contains('is-open') === shouldOpen) return;
                animateMobilePanel(item, shouldOpen, immediate);
            });
        };

        const getCollapsedHeight = () => {
            const shell = header.querySelector<HTMLElement>('.nav-shell');
            if (!shell) return navRow.getBoundingClientRect().height;
            const styles = window.getComputedStyle(shell);
            return Math.ceil(
                navRow.getBoundingClientRect().height
                + Number.parseFloat(styles.paddingTop)
                + Number.parseFloat(styles.paddingBottom),
            );
        };

        const completeMobileTransition = (open: boolean, token: number) => {
            if (token !== mobileTransitionToken) return;
            header.style.height = '';
            header.classList.remove('mobile-closing');
            if (open) return;
            resetMobilePanels();
        };

        const setMobileMenu = (open: boolean) => {
            const token = ++mobileTransitionToken;
            const fromHeight = Math.ceil(header.getBoundingClientRect().height);
            header.style.height = `${fromHeight}px`;

            if (open) {
                header.style.transform = 'translateY(0)';
                headerHidden = false;
                header.classList.remove('mobile-closing');
                header.classList.add('mobile-open');
                menuToggle.setAttribute('aria-expanded', 'true');
                menuToggle.setAttribute('aria-label', 'Cerrar menú principal');
            } else {
                header.classList.remove('mobile-open');
                header.classList.add('mobile-closing');
                menuToggle.setAttribute('aria-expanded', 'false');
                menuToggle.setAttribute('aria-label', 'Abrir menú principal');
            }

            const targetHeight = open ? Math.ceil(window.innerHeight) : getCollapsedHeight();
            header.getBoundingClientRect();
            requestAnimationFrame(() => {
                if (token === mobileTransitionToken) header.style.height = `${targetHeight}px`;
            });

            if (reducedMotion || Math.abs(fromHeight - targetHeight) < 1) {
                requestAnimationFrame(() => completeMobileTransition(open, token));
                return;
            }

            const onTransitionEnd = (event: TransitionEvent) => {
                if (event.target !== header || event.propertyName !== 'height') return;
                header.removeEventListener('transitionend', onTransitionEnd);
                completeMobileTransition(open, token);
            };
            header.addEventListener('transitionend', onTransitionEnd);
        };

        mobileMenuItems.forEach((item) => {
            const trigger = item.querySelector<HTMLButtonElement>('.mobile-menu-trigger');
            const name = item.dataset.mobileMenu!;
            trigger?.addEventListener('click', () => {
                const isOpen = item.classList.contains('is-open');
                setMobilePanel(isOpen ? undefined : name);
            }, { signal });
        });

        document.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape') return;
            if (getCurrentPanel()) closePanel();
            else if (header.classList.contains('mobile-open') || header.classList.contains('mobile-closing')) setMobileMenu(false);
        }, { signal });
        menuToggle.addEventListener('click', () => {
            if (isDesktop()) return;
            const isOpen = !header.classList.contains('mobile-open');
            setMobileMenu(isOpen);
        }, { signal });

        const handleScroll = () => {
            const currentScrollY = window.scrollY;
            const threshold = navRow.getBoundingClientRect().height;
            const menuIsOpen = header.classList.contains('is-expanded') || header.classList.contains('mobile-open') || header.classList.contains('mobile-closing');

            header.classList.toggle('scrolled', currentScrollY > threshold);
            if (menuIsOpen || currentScrollY <= threshold) {
                header.style.transform = 'translateY(0)';
                headerHidden = false;
            } else if (currentScrollY > lastScrollY && !headerHidden) {
                header.style.transform = 'translateY(-100%)';
                headerHidden = true;
            } else if (currentScrollY < lastScrollY && headerHidden) {
                header.style.transform = 'translateY(0)';
                headerHidden = false;
            }
            lastScrollY = currentScrollY;
        };

        window.addEventListener('scroll', handleScroll, { passive: true, signal });
        window.addEventListener('resize', () => {
            const nextViewport = isDesktop();
            if (nextViewport === previousViewport) return;
            previousViewport = nextViewport;
            header.style.height = 'auto';
            header.classList.remove('is-expanded');
            header.classList.remove('mobile-open');
            header.classList.remove('mobile-closing');
            menuToggle.setAttribute('aria-expanded', 'false');
            menuToggle.setAttribute('aria-label', 'Abrir menú principal');
            panels.forEach((panel) => panel.classList.remove('is-current', 'is-leaving'));
            megaRegion.style.height = '0px';
            setMenuState();
            resetMobilePanels();
        }, { signal });

        lastScrollY = window.scrollY;
        handleScroll();
    }

    document.addEventListener('astro:page-load', setupNav);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupNav, { once: true });
    else setupNav();
</script>
