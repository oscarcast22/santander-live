---
const items = ["Misión y Visión", "Objetivo", "Filosofía", "Modelo Educativo"];
---

<div class="accordion">
  {
    items.map((label) => (
      <details class="accordion-item">
        <summary>
          <>
            <h3>{label}</h3>
            <span class="plus" aria-hidden="true" />
          </>
        </summary>
        <div class="accordion-content">
          <p>Contenido institucional pendiente de integrar.</p>
        </div>
      </details>
    ))
  }
</div>
<style>
  .accordion {
    margin: 4rem 0 8.5rem;
  }
  details {
    border-bottom: 1px solid var(--gray-800);
  }
  details.is-animating {
    overflow: hidden;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    margin: 0;
    color: var(--gray-400);
    font-size: 1.1rem;
    font-weight: 500;
    transition:
      color 0.3s ease,
      font-weight 0.3s ease;
  }
  summary:hover h3,
  details[open] summary h3 {
    color: var(--red-200);
    font-weight: 600;
  }
  summary:focus-visible {
    outline: 2px solid var(--red-200);
    outline-offset: 4px;
  }
  .plus {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin-left: 20px;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--gray-400);
    transition: transform 0.25s ease;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0);
  }
  .accordion-content {
    padding: 10px clamp(1.25rem, 2.5vw, 1.75rem) 20px;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.2s ease,
      transform 0.26s ease;
  }
  details[open]:not(.is-opening):not(.is-closing) .accordion-content {
    opacity: 1;
    transform: translateY(0);
  }
  details.is-closing .accordion-content {
    opacity: 0;
    transform: translateY(-5px);
  }
  .accordion-content p {
    margin: 0 0 0.65rem;
    color: var(--gray-400);
    line-height: 1.375;
  }
  .accordion-content > :last-child {
    margin-bottom: 0;
  }
  @media (max-width: 700px) {
    .accordion {
      margin: 2rem 0 4rem;
    }

    summary {
      padding-block: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion-content,
    summary h3,
    .plus::before,
    .plus::after {
      transition-duration: 0.01ms;
    }
  }
</style>
<script>
  let accordionController: AbortController | undefined;

  function setupAccordion() {
    accordionController?.abort();
    accordionController = new AbortController();
    const { signal } = accordionController;
    const animations = new WeakMap<HTMLDetailsElement, Animation>();
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    document
      .querySelectorAll<HTMLElement>(".accordion")
      .forEach((accordion) => {
        const items = [
          ...accordion.querySelectorAll<HTMLDetailsElement>(".accordion-item"),
        ];

        const stopAnimation = (item: HTMLDetailsElement) => {
          const animation = animations.get(item);
          if (!animation) return;
          item.style.height = `${item.getBoundingClientRect().height}px`;
          animation.cancel();
          animations.delete(item);
        };

        const finish = (
          item: HTMLDetailsElement,
          close: boolean,
          animation?: Animation,
        ) => {
          if (animation && animations.get(item) !== animation) return;
          animations.delete(item);
          item.classList.remove("is-animating", "is-opening", "is-closing");
          item.style.height = "";
          item.style.overflow = "";
          if (close) item.open = false;
        };

        const transitionItem = (item: HTMLDetailsElement, open: boolean) => {
          const summary = item.querySelector<HTMLElement>("summary");
          if (!summary) return;
          stopAnimation(item);
          if (reduceMotion) {
            item.classList.remove("is-animating", "is-opening", "is-closing");
            item.open = open;
            return;
          }

          const startHeight = item.getBoundingClientRect().height;
          item.classList.add("is-animating");
          item.style.overflow = "hidden";
          if (open) {
            item.classList.remove("is-closing");
            item.classList.add("is-opening");
            item.open = true;
            item.style.height = "auto";
            const endHeight = item.getBoundingClientRect().height;
            item.style.height = `${startHeight}px`;
            const animation = item.animate(
              [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
              { duration: 360, easing: "cubic-bezier(.4, 0, .2, 1)" },
            );
            animations.set(item, animation);
            requestAnimationFrame(() => item.classList.remove("is-opening"));
            animation.onfinish = () => finish(item, false, animation);
            return;
          }

          item.classList.remove("is-opening");
          item.classList.add("is-closing");
          item.style.height = `${startHeight}px`;
          const endHeight = summary.getBoundingClientRect().height;
          const animation = item.animate(
            [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
            { duration: 300, easing: "cubic-bezier(.4, 0, .2, 1)" },
          );
          animations.set(item, animation);
          animation.onfinish = () => finish(item, true, animation);
        };

        items.forEach((item) => {
          item.querySelector("summary")?.addEventListener(
            "click",
            (event) => {
              event.preventDefault();
              const shouldOpen =
                !item.open || item.classList.contains("is-closing");
              if (shouldOpen)
                items.forEach((other) => {
                  if (other !== item && other.open)
                    transitionItem(other, false);
                });
              transitionItem(item, shouldOpen);
            },
            { signal },
          );
        });
      });
  }

  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", setupAccordion, {
      once: true,
    });
  else setupAccordion();
  document.addEventListener("astro:page-load", setupAccordion);
</script>
