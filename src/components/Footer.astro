---
import BrandLogo from "./BrandLogo.astro";
import SiteIcon from "./SiteIcon.astro";

interface Props {
  spacious?: boolean;
}

const { spacious = false } = Astro.props;
const socials = [
  { label: "Facebook", icon: "facebook", href: "https://www.facebook.com/uadmx" },
  { label: "Instagram", icon: "instagram", href: "https://www.instagram.com/lobosuadmx" },
  { label: "X", icon: "x", href: undefined },
  { label: "TikTok", icon: "tiktok", href: undefined },
  {
    label: "WhatsApp",
    icon: "whatsapp",
    href: "https://api.whatsapp.com/send/?phone=526181102529&text=Me+interesa+recibir+m%C3%A1s+informaci%C3%B3n+de+las+licenciaturas&type=phone_number&app_absent=0",
  },
] as const;
---

<footer class:list={["footer", { "footer-spacious": spacious }]}>
  <div class="container footer-inner">
    <div class="footer-brand">
      <BrandLogo theme="dark" context="footer" alt="Santander Live y UAD" />
    </div>
    <address>
      Avenida Universidad Autónoma de Durango #300<br />Fracc. Jardines de
      Durango.<br />Durango, Durango, México.<br />Teléfono(s): (52) 618 129
      5786 - (52) 618 129 5901
    </address>
    <div class="socials">
      <strong>Síguenos</strong>
      <div class="social-links">
        {
          socials.map(({ label, icon, href }) => {
            const Tag = href ? "a" : "span";
            return <Tag
              class="social-icon"
              href={href}
              target={href ? "_blank" : undefined}
              rel={href ? "noopener noreferrer" : undefined}
              role={href ? undefined : "img"}
              aria-label={label}
              title={href ? label : `Enlace de ${label} por definir`}
            >
              <SiteIcon name={icon} />
            </Tag>;
          })
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    padding: 104px 0 64px;
    border-top: 1px solid var(--gray-800);
    background: #fff;
  }

  .footer-spacious {
    padding: 168px 0 112px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 385px minmax(0, 1fr) 352px;
    align-items: center;
    gap: 48px;
  }

  .footer-brand {
    width: 385px;
    max-width: 100%;
  }

  .footer-brand :global(.brand-logo--footer) {
    width: 100%;
  }

  address {
    font-size: var(--text-caption);
    font-style: normal;
    line-height: 1.2;
  }

  .socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    font-size: var(--text-md);
  }

  .socials strong {
    font-weight: var(--weight-semibold);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .social-icon {
    display: grid;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    place-items: center;
    color: var(--gray-200);
  }

  .social-icon :global(svg),
  .social-icon :global(img) {
    width: 100%;
    height: 100%;
  }

  a.social-icon:focus-visible {
    outline: 2px solid var(--red-200);
    outline-offset: 6px;
    border-radius: 3px;
  }

  .footer-spacious .footer-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0;
    text-align: center;
  }

  .footer-spacious address {
    margin-top: 96px;
  }

  .footer-spacious .socials {
    margin-top: 112px;
  }

  @media (min-width: 1001px) and (max-width: 1180px) {
    .footer:not(.footer-spacious) .footer-inner {
      grid-template-columns: 300px minmax(0, 1fr) 288px;
      gap: 32px;
    }

    .footer:not(.footer-spacious) .footer-brand {
      width: 300px;
    }

    .footer:not(.footer-spacious) .social-links {
      gap: 32px;
    }
  }

  @media (max-width: 1000px) {
    .footer,
    .footer-spacious {
      padding: 56px 0;
    }

    .footer-inner,
    .footer-spacious .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      text-align: center;
    }

    .footer-brand {
      width: min(320px, 100%);
    }

    .footer-spacious address,
    .footer-spacious .socials {
      margin-top: 0;
    }
  }

  @media (max-width: 600px) {
    .social-links {
      gap: 24px;
    }
  }
</style>
