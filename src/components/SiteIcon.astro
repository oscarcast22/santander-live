---
type IconName =
  | "classroom"
  | "clock"
  | "book"
  | "facebook"
  | "instagram"
  | "x"
  | "tiktok"
  | "whatsapp";

interface Props {
  name: IconName;
}

const { name } = Astro.props;

const iconPaths: Record<IconName, string> = {
  classroom: "benefits/classroom.svg",
  clock: "benefits/clock.svg",
  book: "benefits/book.svg",
  facebook: "social/facebook.svg",
  instagram: "social/instagram.svg",
  x: "social/x.svg",
  tiktok: "social/tiktok.svg",
  whatsapp: "social/whatsapp.svg",
};

const iconAssets = import.meta.glob<string>("../assets/icons/**/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});
const iconSrc = iconAssets[`../assets/icons/${iconPaths[name]}`];
const benefitIcon = name === "classroom" || name === "clock" || name === "book";
---

{
  iconSrc ? (
    <img
      class="site-icon-image"
      src={iconSrc}
      alt=""
      aria-hidden="true"
      width={benefitIcon ? 54 : 32}
      height={benefitIcon ? 54 : 32}
    />
  ) : (
    <svg
      class:list={[
        "site-icon-fallback",
        { "site-icon-fallback--benefit": benefitIcon },
      ]}
      viewBox={benefitIcon ? "0 0 40 40" : "0 0 24 24"}
      aria-hidden="true"
    >
      {name === "classroom" && (
        <>
          <rect x="6" y="5" width="28" height="21" rx="1.5" />
          <circle cx="20" cy="13" r="3.2" />
          <path d="M13.5 22c.7-3.2 2.8-4.8 6.5-4.8s5.8 1.6 6.5 4.8M20 26v5m-7 4h14m-11-4h8" />
        </>
      )}
      {name === "clock" && (
        <>
          <circle cx="20" cy="20" r="14" />
          <path d="M20 11v9l6 4" />
        </>
      )}
      {name === "book" && (
        <path d="M7 8h11a4 4 0 0 1 4 4v21a4 4 0 0 0-4-4H7zM33 8H22v25a4 4 0 0 1 4-4h7zM11 14h5m-5 5h5m10-5h3m-3 5h3" />
      )}
      {name === "facebook" && (
        <path d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.8v8h3.4Z" />
      )}
      {name === "instagram" && (
        <>
          <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle class="social-icon-dot" cx="17.5" cy="6.8" r="1" />
        </>
      )}
      {name === "x" && (
        <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.1l-4.8-7L6.2 22H3l7.3-8.4L2.8 2H9l4.4 6.5L18.9 2Zm-1.1 17.9h1.7L8 4H6.2l11.6 15.9Z" />
      )}
      {name === "tiktok" && (
        <path d="M19.7 8.2a7.3 7.3 0 0 1-4.4-1.5v8.1a6.1 6.1 0 1 1-5.3-6v3.4a2.8 2.8 0 1 0 2 2.7V2.5h3.3c.1 2 1.7 3.8 4.4 4.1v1.6Z" />
      )}
      {name === "whatsapp" && (
        <>
          <path
            class="site-icon-whatsapp-outline"
            d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z"
          />
          <path d="M9 8.3c.2-.3.4-.3.6-.3h.5c.2 0 .4.1.5.4l.8 1.9c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.5.8 1.2 1.5 2 2 .2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.2.1.3.3.2.5-.1.6-.6 1.2-1.2 1.4-.5.2-1.2.3-2.1 0-1.2-.4-2.5-1.2-3.6-2.3-1.2-1.2-2-2.6-2.2-3.6-.2-.9 0-1.5.4-1.9.4-.4.8-.6 1.1-.6Z" />
        </>
      )}
    </svg>
  )
}

<style>
  .site-icon-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-icon-fallback {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .site-icon-fallback--benefit {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .site-icon-fallback:not(.site-icon-fallback--benefit) rect,
  .site-icon-fallback:not(.site-icon-fallback--benefit) circle,
  .site-icon-whatsapp-outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .site-icon-fallback .social-icon-dot {
    fill: currentColor;
    stroke: none;
  }
</style>
