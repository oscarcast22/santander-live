---
import { getCollection } from "astro:content";

const programs = await getCollection("programas");
const licensePrograms = programs.filter(
  (program) => program.data.nivel === "licenciaturas",
);
const postgraduatePrograms = programs.filter(
  (program) => program.data.nivel === "posgrados",
);

const maestrias = postgraduatePrograms.filter(
  (program) => program.data.categoria === "maestria",
);
const doctorados = postgraduatePrograms.filter(
  (program) => program.data.categoria === "doctorado",
);
---

<section class="contact" id="contacto" aria-labelledby="contact-title">
  <div class="contact-inner">
    <h2 id="contact-title">¿Listo para el siguiente paso a tu futuro?</h2>
    <form aria-label="Solicitud de información">
      <div class="form-group">
        <label for="contact-nombre">Tu nombre</label>
        <input
          id="contact-nombre"
          name="nombre"
          type="text"
          autocomplete="name"
          placeholder="Nombre y apellido"
          required
        />
      </div>
      <div class="form-group">
        <label for="contact-telefono">Número de teléfono</label>
        <input
          id="contact-telefono"
          name="telefono"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          placeholder="Ingresa tu número de teléfono"
          required
        />
      </div>
      <div class="form-group">
        <label for="contact-programa">Licenciatura o Posgrado de interés</label>
        <select id="contact-programa" name="programa" required>
          <option value="">Selecciona una opción</option>
          <optgroup label="Licenciaturas"
            >{
              licensePrograms.map((program) => (
                <option value={program.data.slug}>{program.data.title}</option>
              ))
            }</optgroup
          >
          <optgroup label="Maestrías"
            >{
              maestrias.map((program) => (
                <option value={program.data.slug}>{program.data.title}</option>
              ))
            }</optgroup
          >
          <optgroup label="Doctorados"
            >{
              doctorados.map((program) => (
                <option value={program.data.slug}>{program.data.title}</option>
              ))
            }</optgroup
          >
        </select>
      </div>
      <div class="form-group">
        <label for="contact-correo">Correo electrónico</label>
        <input
          id="contact-correo"
          name="correo"
          type="email"
          autocomplete="email"
          placeholder="Ingresa tu correo electrónico"
          required
        />
      </div>
      <label class="privacy" for="contact-privacidad">
        <input
          id="contact-privacidad"
          type="checkbox"
          name="privacidad"
          required
        />
        <span
          >He leído el aviso de privacidad aplicable a esta solicitud de
          contacto.</span
        >
      </label>
      <button class="button" type="submit" disabled
        >Recibir más información</button
      >
      <p class="privacy-note">
        Tus datos están protegidos por nuestra Política de Privacidad.
      </p>
    </form>
  </div>
</section>

<style>
  .contact {
    min-height: min(52vw, 1000px);
    padding: min(6.25vw, 120px) 1.25rem 4rem;
    background: var(--gray-100);
    color: #fff;
    scroll-margin-top: 6rem;
  }
  .contact-inner {
    width: min(100%, 680px);
    margin: auto;
  }
  h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
  }
  form {
    display: flex;
    flex-direction: column;
  }
  .form-group {
    margin-bottom: 0.9rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.2rem;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .form-group input,
  .form-group select {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 72%);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: var(--text-sm);
    transition: border-color 180ms ease;
  }
  .form-group input::placeholder {
    color: var(--gray-400);
  }
  .form-group select {
    color-scheme: dark;
  }
  .form-group input:hover,
  .form-group input:focus-visible,
  .form-group select:hover,
  .form-group select:focus-visible {
    border-color: var(--red-200);
  }
  .privacy {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.4rem;
    font-size: var(--text-xs);
    line-height: 1.45;
    cursor: pointer;
  }
  .privacy input {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    margin: 0.08rem 0 0;
    accent-color: var(--red-200);
  }
  .privacy input:focus-visible {
    outline: 2px solid var(--red-200);
    outline-offset: 3px;
  }
  .contact .button {
    align-self: flex-start;
    margin-top: 1.5rem;
    padding: 0.45rem 1rem;
    min-height: 2rem;
    font-size: var(--text-sm);
  }
  .contact .button:disabled {
    cursor: not-allowed;
    opacity: 0.75;
    transform: none;
  }
  .privacy-note {
    margin: 1.5rem 0 0;
    color: var(--gray-400);
    font-size: var(--text-xs);
  }
  @media (max-width: 800px) {
    .contact {
      min-height: 0;
      padding: 4rem 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .form-group input,
    .form-group select {
      transition: none;
    }
  }
</style>
