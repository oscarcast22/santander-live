---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import banner from "../assets/banner-educacion.webp";

interface Props {
  program: CollectionEntry<"programas">;
  model: CollectionEntry<"modelos">["data"];
}
const { program, model } = Astro.props;
const { title, curriculum, graduateProfile } = program.data;
const hasGraduateProfile = Boolean(
  graduateProfile?.some((paragraph) => paragraph.trim().length > 0),
);
type ProfileBlock =
  | { type: "paragraph"; text: string }
  | { type: "heading"; text: string }
  | { type: "list"; items: string[] };

const profileBlocks: ProfileBlock[] = [];
let profileListItems: string[] = [];
let profileListExpected = false;

const flushProfileList = () => {
  if (profileListItems.length) {
    profileBlocks.push({ type: "list", items: profileListItems });
    profileListItems = [];
  }
};

for (const rawText of graduateProfile ?? []) {
  const text = rawText.trim();
  if (!text) continue;
  const listItem = text.match(/^[-–•·]\s*(.+)$/u);

  if (listItem) {
    const itemText = listItem[1];
    if (itemText) profileListItems.push(itemText.trim());
    continue;
  }

  if (text.endsWith(":")) {
    flushProfileList();
    profileBlocks.push({ type: "heading", text });
    profileListExpected = true;
    continue;
  }

  // Several source profiles omit bullets after phrases such as “será capaz de:”.
  // Keep those short entries together as a semantic list; long passages return to prose.
  if (profileListExpected && text.length <= 320) {
    profileListItems.push(text);
    continue;
  }

  flushProfileList();
  profileBlocks.push({ type: "paragraph", text });
  profileListExpected = false;
}
flushProfileList();

const tabs = [
  { id: "modelo", label: "Modelo Educativo" },
  { id: "plan", label: "Plan de Estudios" },
  ...(hasGraduateProfile
    ? [{ id: "perfil", label: "Perfil de Egreso" }]
    : []),
];
---

<div class="program-tabs" data-tabs>
  <div
    class="tab-list"
    role="tablist"
    aria-label={`Información de ${title}`}
  >
    {
      tabs.map((tab, index) => (
        <button
          id={`tab-${tab.id}`}
          role="tab"
          type="button"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${tab.id}`}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <section
    id="panel-modelo"
    role="tabpanel"
    aria-labelledby="tab-modelo"
    tabindex="0"
  >
    <p>
      {model.paragraphs[0]}
    </p>
    <figure class="program-banner">
      <Image
        src={banner}
        alt="Estudiante trabajando en una computadora"
        widths={[700, 1100, 1400]}
        sizes="(max-width: 800px) 100vw, 1270px"
        quality={85}
      />
      <figcaption>Transformando la educación</figcaption>
    </figure>
    {model.paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section
    id="panel-plan"
    role="tabpanel"
    aria-labelledby="tab-plan"
    tabindex="0"
    hidden
  >
    {
      curriculum.length ? (
        <div class="curriculum">
          {curriculum.map(({ period, subjects }) => (
            <section class="curriculum-period">
              <h2>{period}</h2>
              <ul>
                {subjects.map((subject) => <li>{subject}</li>)}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p>Plan de estudios pendiente de integrar.</p>
      )
    }
  </section>
  {
    hasGraduateProfile && (
      <section
        id="panel-perfil"
        role="tabpanel"
        aria-labelledby="tab-perfil"
        tabindex="0"
        hidden
      >
        <div class="graduate-profile">
          {profileBlocks.map((block) => {
            if (block.type === "heading") return <h2>{block.text}</h2>;
            if (block.type === "list") {
              return (
                <ul>
                  {block.items.map((item) => <li>{item}</li>)}
                </ul>
              );
            }
            return <p>{block.text}</p>;
          })}
        </div>
      </section>
    )
  }
</div>
<style>
  .tab-list {
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem;
    border-bottom: 1px solid var(--gray-800);
  }
  [role="tab"] {
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--gray-200);
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  [role="tab"]:hover,
  [role="tab"]:focus-visible {
    color: var(--red-200);
  }
  [role="tab"][aria-selected="true"] {
    border-color: var(--red-200);
    color: var(--gray-100);
  }
  [role="tabpanel"] {
    padding-top: 1.5rem;
    color: var(--gray-400);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  [role="tabpanel"][hidden] {
    display: none;
  }
  [role="tabpanel"] p {
    margin: 0 0 1.55rem;
  }
  .graduate-profile {
    display: grid;
    gap: 1rem;
  }
  .graduate-profile p {
    margin: 0;
    line-height: 1.65;
  }
  .graduate-profile h2 {
    margin: 0.25rem 0 -0.35rem;
    color: var(--gray-200);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .graduate-profile ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.35rem;
  }
  .graduate-profile li {
    padding-left: 0.15rem;
    line-height: 1.6;
  }
  .graduate-profile li::marker {
    color: var(--gray-200);
  }
  .curriculum {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }
  .curriculum-period h2 {
    margin: 0 0 0.55rem;
    color: var(--gray-200);
    font-size: 1rem;
    font-weight: 600;
  }
  .curriculum-period ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .program-banner {
    position: relative;
    margin: 1.7rem 0 2.3rem;
    overflow: hidden;
  }
  .program-banner :global(img) {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }
  .program-banner figcaption {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    color: white;
    font-size: clamp(1.35rem, 3vw, 2.35rem);
    font-style: italic;
    text-align: center;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
  }
  @media (max-width: 600px) {
    .tab-list {
      gap: 0.75rem 1.25rem;
    }
    [role="tab"] {
      font-size: 0.77rem;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let selectedIndex = 0;
    let panelAnimation: Animation | undefined;

    const select = (index: number, focus = false) => {
      if (index === selectedIndex) {
        if (focus) tabs[index]?.focus();
        return;
      }

      const direction = index > selectedIndex ? 1 : -1;
      panelAnimation?.cancel();
      panelAnimation = undefined;

      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        if (focus && i === index) tab.focus();
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      selectedIndex = index;

      const panel = panels[index];
      if (panel && !reducedMotion.matches) {
        const animation = panel.animate(
          [
            { opacity: 0, transform: `translateX(${direction * 8}px)` },
            { opacity: 1, transform: "translateX(0)" },
          ],
          { duration: 200, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
        );
        panelAnimation = animation;
        animation.onfinish = () => {
          if (panelAnimation === animation) panelAnimation = undefined;
        };
      }
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
          event.preventDefault();
          select(
            (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
              tabs.length,
            true,
          );
        }
        if (event.key === "Home") {
          event.preventDefault();
          select(0, true);
        }
        if (event.key === "End") {
          event.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });
  });
</script>
