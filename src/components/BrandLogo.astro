---
const brandLogos = import.meta.glob<string>("../assets/brand/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});

interface Props {
  theme?: "light" | "dark";
  context?: "header" | "footer" | "hero";
  alt?: string;
}

const {
  theme = "dark",
  context = "footer",
  alt = "Santander Live Streaming y Universidad Autónoma de Durango",
} = Astro.props;
const logoSrc = brandLogos[`../assets/brand/santander-live-${theme}.svg`];
---

<span
  class:list={["brand-logo", `brand-logo--${theme}`, `brand-logo--${context}`]}
  role={alt ? "img" : undefined}
  aria-label={alt || undefined}
>
  {
    logoSrc ? (
      <img src={logoSrc} alt="" width="350" height="65" />
    ) : (
      <span class="brand-logo__fallback" aria-hidden="true">
        <span class="brand-logo__name">Santander Live</span>
        <span class="brand-logo__university">
          Universidad Autónoma de Durango
        </span>
      </span>
    )
  }
</span>

<style>
  .brand-logo {
    display: block;
    flex: 0 0 auto;
    line-height: 0;
  }

  .brand-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-logo--light {
    color: #fff;
  }

  .brand-logo--dark {
    color: #1f1f1f;
  }

  .brand-logo__fallback {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    line-height: 1;
  }

  .brand-logo__name {
    font-size: clamp(1rem, 3.2vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .brand-logo__university {
    font-size: clamp(0.45rem, 1.05vw, 0.7rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand-logo--header {
    width: var(--header-logo-width);
  }

  .brand-logo--footer {
    width: min(430px, 100%);
  }

  .brand-logo--hero {
    width: min(430px, 74vw);
  }

  @media (max-width: 850px) {
    .brand-logo--footer {
      width: min(340px, 100%);
    }
  }

  @media (max-width: 700px) {
    .brand-logo--hero {
      width: min(280px, 74vw);
    }
  }
</style>
