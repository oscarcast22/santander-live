---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { Font, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultImage from "../assets/hero-inicio.webp";
import brandLogo from "../assets/brand/santander-live-dark.svg?url";
import { absoluteUrl, canonicalUrl, site } from "../data/site";
import {
  breadcrumbSchema,
  identitySchema,
  serializeSchema,
  websiteId,
} from "../lib/seo";
import type { SchemaNode } from "../lib/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  footerSpacious?: boolean;
  seoImage?: ImageMetadata;
  seoImageAlt?: string;
  pageKind?: "WebPage" | "AboutPage";
  noindex?: boolean;
  structuredData?: SchemaNode[];
  mainEntityId?: string;
}
const {
  title,
  description,
  footerSpacious = false,
  seoImage = defaultImage,
  seoImageAlt = "Estudiante con audífonos y computadora de Santander Live Streaming",
  pageKind = "WebPage",
  noindex = false,
  structuredData = [],
  mainEntityId,
} = Astro.props;
const canonical = canonicalUrl(
  Astro.url.pathname.replace(/^\/404\/?$/, "/404.html"),
);
const pageTitle = `${title} | ${site.name}`;
const socialImage = await getImage({
  src: seoImage,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 85,
});
const imageUrl = absoluteUrl(socialImage.src);
const breadcrumbs = Astro.url.pathname !== "/" && !noindex;
const graph: SchemaNode[] = [
  ...identitySchema(absoluteUrl(brandLogo)),
  {
    "@type": pageKind,
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    inLanguage: site.language,
    isPartOf: { "@id": websiteId },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: imageUrl,
      width: 1200,
      height: 630,
    },
    ...(breadcrumbs
      ? { breadcrumb: { "@id": `${canonical}#breadcrumb` } }
      : {}),
    ...(mainEntityId ? { mainEntity: { "@id": mainEntityId } } : {}),
  },
  ...(breadcrumbs ? [breadcrumbSchema(canonical, title)] : []),
  ...structuredData,
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#c10230" />
    <Font cssVariable="--font-montserrat" preload={[{ style: "normal" }]} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seoImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={seoImageAlt} />
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      is:inline
      set:html={serializeSchema(graph)}
    />
    <script is:inline data-astro-rerun>
      document.documentElement.dataset.jsEnabled = "true";
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <slot />
    <Footer spacious={footerSpacious} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: -5rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    background: white;
    color: #111;
  }
  .skip-link:focus {
    top: 1rem;
  }
</style>
