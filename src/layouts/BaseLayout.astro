---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  footerSpacious?: boolean;
}
const { title, description, footerSpacious = false } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#c10230" />
    <Font cssVariable="--font-montserrat" preload={[{ style: "normal" }]} />
    <meta name="description" content={description} />
    <title>{title} | Santander Live</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <slot />
    <Footer spacious={footerSpacious} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: -5rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    background: white;
    color: #111;
  }
  .skip-link:focus {
    top: 1rem;
  }
</style>
