---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ParallaxHero from "../../components/ParallaxHero.astro";
import hero from "../../assets/hero-programa.webp";
import { getCollection } from "astro:content";

const postgraduatePrograms = await getCollection(
  "programas",
  ({ data }) => data.nivel === "posgrados",
);

const maestrias = postgraduatePrograms.filter(
  (program) => program.data.categoria === "maestria",
);
const doctorados = postgraduatePrograms.filter(
  (program) => program.data.categoria === "doctorado",
);
---

<BaseLayout
  title="Posgrados"
  description="Oferta de maestrías y doctorados de Santander Live."
>
  <ParallaxHero
    image={hero}
    alt="Estudiante en modalidad Live Streaming"
    variant="program"
  />
  <main id="contenido">
    <section class="container overview">
      <h1>Posgrados</h1><p>
        Maestrías y doctorados en modalidad Live Streaming.
      </p><div class="categories">
        <section>
          <h2>Maestrías</h2><ul>
            {
              maestrias.map((program) => (
                <li>
                  <a href={`/posgrados/${program.data.slug}`}>{program.data.title}</a>
                </li>
              ))
            }
          </ul>
        </section><section>
          <h2>Doctorados</h2><ul>
            {
              doctorados.map((program) => (
                <li>
                  <a href={`/posgrados/${program.data.slug}`}>{program.data.title}</a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .overview {
    padding-block: 5rem 12rem;
    min-height: 700px;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 400;
  }
  .categories {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }
  .categories section {
    padding: 2rem;
    border: 1px solid var(--gray-800);
  }
  .categories ul {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.9;
  }
  .categories a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 600px) {
    .categories {
      grid-template-columns: 1fr;
    }
  }
</style>
