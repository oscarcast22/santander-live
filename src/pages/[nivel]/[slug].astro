---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParallaxHero from '../../components/ParallaxHero.astro';
import ProgramTabs from '../../components/ProgramTabs.astro';
import { programs, type Program } from '../../data/site';
import hero from '../../assets/hero-programa.webp';

export function getStaticPaths() {
  return programs.map((program) => ({ params: { nivel: program.level, slug: program.slug }, props: { program } }));
}

interface Props { program: Program; }
const { program } = Astro.props;
const heading = program.category === 'maestria' ? `Maestría en ${program.title}` : program.category === 'doctorado' ? `Doctorado en ${program.title}` : program.title;
---
<BaseLayout title={heading} description={program.description ?? `Conoce el programa de ${heading} en Santander Live.`}>
  <ParallaxHero image={hero} alt="Estudiante en modalidad Live Streaming" variant="program" />
  <main id="contenido"><article class="program-body container"><h1>{heading}</h1>{program.description && <p class="program-description">{program.description}</p>}<ProgramTabs program={program} /></article></main>
</BaseLayout>
<style>
  .program-body { padding-top: 3.5rem; padding-bottom: 10rem; min-height: 880px; }
  .program-body h1 { margin: 0 0 1.2rem; font-size: clamp(2.4rem, 4vw, 4rem); font-weight: 400; }
  .program-description { margin: 0 0 1.6rem; color: #626262; font-size: .95rem; line-height: 1.55; }
  @media (max-width: 700px) { .program-body { padding-top: 2.5rem; min-height: 650px; } }
</style>
