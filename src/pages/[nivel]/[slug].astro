---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ParallaxHero from "../../components/ParallaxHero.astro";
import ProgramTabs from "../../components/ProgramTabs.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const programs = await getCollection("programas");
  const paths = [];

  for (const program of programs) {
    const model = await getEntry(program.data.model);
    if (!model) {
      throw new Error(`No se encontró el modelo educativo de ${program.data.title}`);
    }

    paths.push({
      params: { nivel: program.data.nivel, slug: program.data.slug },
      props: { program, model: model.data },
    });
  }

  return paths;
}

interface Props {
  program: CollectionEntry<"programas">;
  model: CollectionEntry<"modelos">["data"];
}
const { program, model } = Astro.props;
const { title, categoria, overview } = program.data;
type OverviewBlock =
  | { type: "paragraph"; text: string }
  | { type: "list"; items: string[] };

const overviewBlocks: OverviewBlock[] = [];
let overviewListItems: string[] = [];

const flushOverviewList = () => {
  if (overviewListItems.length) {
    overviewBlocks.push({ type: "list", items: overviewListItems });
    overviewListItems = [];
  }
};

for (const rawText of overview) {
  const text = rawText.trim();
  if (!text) continue;

  const listItem = text.match(/^[-–•·]\s*(.+)$/u);
  if (listItem) {
    const itemText = listItem[1];
    if (itemText) overviewListItems.push(itemText.trim());
    continue;
  }

  flushOverviewList();
  overviewBlocks.push({ type: "paragraph", text });
}
flushOverviewList();

const heading =
  categoria === "maestria"
    ? `Maestría en ${title}`
    : categoria === "doctorado"
      ? `Doctorado en ${title}`
      : title;
const description =
  overview[0]?.replace(/^[-–•·]\s*/, "") ??
  `Conoce el programa de ${heading} en Santander Live.`;
---

<BaseLayout
  title={heading}
  description={description}
>
  <ParallaxHero
    image={program.data.heroImage}
    alt="Estudiante en modalidad Live Streaming"
    variant="program"
  />
  <main id="contenido">
    <article class="program-body container">
      <h1>{heading}</h1>
      {
        overviewBlocks.length > 0 && (
          <div class="program-overview">
            {overviewBlocks.map((block) => {
              if (block.type === "list") {
                return (
                  <ul>
                    {block.items.map((item) => <li>{item}</li>)}
                  </ul>
                );
              }
              return <p class="program-description">{block.text}</p>;
            })}
          </div>
        )
      }
      <ProgramTabs program={program} model={model} />
    </article>
  </main>
</BaseLayout>
<style>
  .program-body {
    padding-top: 3.5rem;
    padding-bottom: 12rem;
    min-height: 880px;
  }
  .program-body h1 {
    margin: 0 0 1.2rem;
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 400;
  }
  .program-overview {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.6rem;
  }
  .program-description {
    margin: 0;
    color: var(--gray-400);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .program-overview ul {
    display: grid;
    gap: 0.35rem;
    margin: 0.15rem 0;
    padding-left: 1.3rem;
    color: var(--gray-400);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .program-overview li {
    padding-left: 0.15rem;
  }
  .program-overview li::marker {
    color: var(--gray-200);
  }
  @media (max-width: 700px) {
    .program-body {
      padding-top: 2.5rem;
      min-height: 650px;
    }
  }
</style>
