---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ParallaxHero from "../components/ParallaxHero.astro";
import ContactForm from "../components/ContactForm.astro";
import SiteIcon from "../components/SiteIcon.astro";
import TextReveal from "../components/TextReveal.astro";
import OfferCards from "../components/OfferCards.astro";
import { getCollection } from "astro:content";
import hero from "../assets/hero-inicio.webp";
import student from "../assets/estudiante-index.webp";
import laptop from "../assets/laptop-lbs.webp";

const programs = await getCollection("programas");
const sortPrograms = (items: typeof programs) =>
  [...items].sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "es", { sensitivity: "base" }),
  );
const licensePrograms = sortPrograms(
  programs.filter(({ data }) => data.nivel === "licenciaturas"),
);
const masterPrograms = sortPrograms(
  programs.filter(
    ({ data }) => data.nivel === "posgrados" && data.categoria === "maestria",
  ),
);
const doctoratePrograms = sortPrograms(
  programs.filter(
    ({ data }) => data.nivel === "posgrados" && data.categoria === "doctorado",
  ),
);
const benefits = [
  {
    title: "Clases Virtuales",
    icon: "classroom",
    text: "SLS te permite tomar tus clases desde cualquier lugar con acceso a internet.",
  },
  {
    title: "Programas a 3 años",
    icon: "clock",
    text: "Licenciaturas en modalidad Live Streaming con una duración de 3 años.",
  },
  {
    title: "Libros LBS",
    icon: "book",
    text: "Toda la información de tu Licenciatura en un solo lugar y en cualquier lugar.",
  },
] as const;
---

<BaseLayout
  title="Inicio"
  description="Estudia licenciaturas en modalidad Live Streaming con Santander Live."
  footerSpacious
>
  <ParallaxHero
    image={hero}
    alt="Estudiante con audífonos y computadora"
    variant="home"
  >
    <div class="hero-copy">
      <h1>Tu licenciatura Nocturna<br />en tiempo real</h1><p>
        de 8:00 pm a 10:00 pm
      </p>
    </div>
  </ParallaxHero>
  <main id="contenido">
    <section
      class="benefit-section container"
      aria-label="Beneficios de Santander Live"
    >
      <div class="benefits">
        {
          benefits.map((item) => (
            <div class="benefit">
              <>
                <span class="benefit-symbol" aria-hidden="true">
                  <SiteIcon name={item.icon} />
                </span>
                <h2>{item.title}</h2>
                <p>{item.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </section>
    <section class="statement container">
      <TextReveal text="Transformando la educación" />
    </section>
    <section class="education">
      <div class="container education-grid">
        <Image
          src={student}
          alt="Estudiante con computadora portátil"
          widths={[480, 770, 1000]}
          sizes="(max-width: 800px) 100vw, 50vw"
          quality={85}
        />
        <div class="education-copy">
          <h2>Educación a <span>tu<br /> ritmo de vida</span></h2>
          <ul>
            <li>Horario accesible</li>
            <li>Contenidos digitales</li>
            <li>Programas avalados por SEP</li>
            <li>Clases virtuales en vivo</li>
            <li>Grupos conformados</li>
          </ul><a class="button" href="#oferta">Ver oferta educativa</a>
        </div>
      </div>
    </section>
    <section class="lbs container" aria-labelledby="lbs-title">
      <div class="lbs-copy">
        <h2 id="lbs-title">Libros <span>LBS+</span></h2>
        <p class="lbs-kicker">Todo en un Solo Lugar</p>
        <p>
          LBS+ (Learning Bicultural System) es un sistema educativo que se apoya
          en el uso de la tecnología, a través una app propia, con libros
          digitales e interactivos basados en planes de estudio para nivel
          Licenciatura.
        </p>
        <p>
          La app LBS+ es compatible con dispositivos móviles que cuenten con
          sistema operativo iOS y Android, al igual que está disponible para su
          uso en web.
        </p>
      </div>
      <div class="lbs-device">
        <Image
          src={laptop}
          alt="Computadora portátil del sistema LBS+"
          widths={[500, 900, 1300]}
          sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 800px) calc(100vw - 48px), (max-width: 1280px) calc(29vw + 200px), (max-width: 1920px) 44.6vw, 856px"
          quality={85}
        /><strong>LBS+</strong>
      </div>
    </section>
    <OfferCards {licensePrograms} {masterPrograms} {doctoratePrograms} />
    <ContactForm />
  </main>
</BaseLayout>

<style>
  .hero-copy {
    margin-top: 8rem;
    text-align: center;
    text-shadow: 0 2px 9px rgb(0 0 0 / 0.45);
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.2rem, 3.4vw, 4rem);
    line-height: 1.02;
    font-weight: 700;
  }
  .hero-copy p {
    margin: 0.35rem 0 0;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
  }
  .benefit-section {
    height: 0;
    position: relative;
    z-index: 2;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: fit-content;
    margin: auto;
    transform: translateY(-72%);
    background: var(--gray-100);
    color: #fff;
    box-shadow: 0 10px 25px rgb(0 0 0 / 0.12);
  }
  .benefit {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.7rem;
    text-align: center;
  }
  .benefit + .benefit::before {
    content: "";
    position: absolute;
    inset: 28px auto 28px 0;
    width: 1px;
    background: #c0c0c0;
  }
  .benefit-symbol {
    display: block;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin: 0 auto 0.65rem;
  }
  .benefit-symbol :global(svg),
  .benefit-symbol :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .benefit-symbol :global(svg) {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
  .benefit h2 {
    margin: 0 0 0.4rem;
    font-size: var(--text-card-title);
    font-weight: var(--weight-semibold);
  }
  .benefit p {
    max-width: 9rem;
    margin: 0;
    font-size: var(--text-caption);
    line-height: 1.4;
  }
  .statement {
    min-height: min(56.25vw, 1080px);
    display: grid;
    place-items: center;
    text-align: center;
  }
  .education {
    background: var(--gray-950);
    overflow: hidden;
  }
  .education-grid {
    padding-top: clamp(48px, 7.4vw, 142px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 4rem;
  }
  .education-grid :global(img) {
    width: min(100%, 670px);
    max-height: 620px;
    object-fit: contain;
    object-position: bottom;
  }
  .education-copy {
    align-self: start;
  }
  .education-copy h2 {
    margin: 0 0 1.3rem;
    font-size: clamp(2.25rem, 4.2vw, 4rem);
    font-weight: var(--weight-bold);
    line-height: 1.1;
  }
  .education-copy h2 span {
    color: var(--red-200);
  }
  .education-copy ul {
    margin: 0;
    padding-left: 2.5rem;
    color: var(--gray-200);
    line-height: 2.4;
    font-size: clamp(0.875rem, 0.9375vw, 1.125rem);
    font-weight: var(--weight-regular);
  }
  .education-copy .button {
    min-height: 29px;
    margin-top: clamp(24px, calc(12vw - 48px), 48px);
    padding: 0.2rem 14px;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    box-shadow: 0 3px 8px rgb(0 0 0 / 0.16);
  }
  .lbs {
    max-width: 1920px;
    min-height: min(59.7vw, 1146px);
    padding-top: clamp(80px, 11.9vw, 229px);
    padding-bottom: clamp(80px, 21.3vw, 409px);
    padding-left: clamp(var(--page-gutter), calc(36vw - 264px), min(15.375vw, 295px));
    padding-right: clamp(var(--page-gutter), calc(13.5vw - 84px), min(6.94vw, 133px));
    display: grid;
    grid-template-columns: minmax(0, 635fr) minmax(0, 45fr) minmax(0, 812fr);
    align-items: center;
  }
  .lbs-copy {
    grid-column: 1 / 3;
    grid-row: 1;
    padding: clamp(28px, 2.6vw, 50px) clamp(20px, 1.5625vw, 30px);
    border-radius: clamp(24px, 2.083vw, 40px);
    background: #f7f7f7;
    box-shadow: 0 0 8px rgb(0 0 0 / 0.08);
  }
  .lbs-copy h2 {
    margin: 0 0 clamp(16px, 1.25vw, 24px);
    font-size: clamp(2.2rem, 3.75vw, 4.5rem);
    font-weight: var(--weight-regular);
    line-height: 1.15;
  }
  .lbs-copy h2 span {
    color: #29abe2;
    font-weight: var(--weight-bold);
  }
  .lbs-copy p {
    margin: 0 0 clamp(16px, 1.125vw, 21.6px);
    color: var(--gray-200);
    font-size: clamp(0.875rem, 0.9375vw, 1.125rem);
    font-weight: var(--weight-regular);
    line-height: 1.2;
  }
  .lbs-copy p:last-child {
    margin-bottom: 0;
  }
  .lbs-device {
    grid-column: 2 / 4;
    grid-row: 1;
    position: relative;
  }
  .lbs-device :global(img) {
    width: 100%;
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.2));
  }
  .lbs-device strong {
    position: absolute;
    top: 47%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(2.5rem, 6.45vw, 7.75rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    white-space: nowrap;
  }
  @media (max-width: 800px) {
    .hero-copy {
      margin-top: 4rem;
    }
    .benefit-section {
      height: auto;
    }
    .benefits {
      --benefit-overlap: 120px;
      width: 100%;
      transform: translateY(calc(-1 * var(--benefit-overlap)));
      margin-bottom: calc(-1 * var(--benefit-overlap));
    }
    .statement {
      min-height: 370px;
    }
    .lbs {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 2rem;
      padding-inline: var(--page-gutter);
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .lbs-copy,
    .lbs-device {
      grid-column: 1;
      grid-row: auto;
    }
  }
  @media (min-width: 701px) and (max-width: 992px) {
    .hero-copy {
      margin-top: clamp(2rem, calc(50vw - 368px), 8rem);
    }
  }
  @media (min-width: 601px) and (max-width: 992px) {
    .education-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: clamp(16px, 3vw, 32px);
    }
    .education-copy h2 {
      font-size: clamp(1.75rem, 3.6vw, 2.25rem);
    }
  }
  @media (max-width: 600px) {
    .education-grid {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 48px;
    }
    .education-copy {
      grid-row: 1;
      padding: 0 0 2rem;
      text-align: center;
    }
    .education-copy ul {
      text-align: left;
    }
    .education-copy h2 {
      text-align: left;
    }
    .education-grid :global(img) {
      max-height: 430px;
      margin: auto;
    }
    .hero-copy h1 {
      font-size: 2rem;
    }
    .benefits {
      grid-template-columns: 1fr;
      max-width: 80%;
    }
    .benefit + .benefit::before {
      inset: 0 24px auto;
      width: auto;
      height: 1px;
    }
    .benefit {
      padding: 1.5rem 1rem;
    }
    .benefit-symbol {
      width: 30px;
      height: 30px;
    }
    .statement {
      min-height: 300px;
    }
  }
</style>
