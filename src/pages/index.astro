---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ParallaxHero from "../components/ParallaxHero.astro";
import ContactForm from "../components/ContactForm.astro";
import SiteIcon from "../components/SiteIcon.astro";
import { getCollection } from "astro:content";
import hero from "../assets/hero-inicio.webp";
import student from "../assets/estudiante-amarillo.webp";
import laptop from "../assets/laptop-lbs.webp";
import licenseCard from "../assets/landing/oferta-licenciaturas.jpg";
import postgraduateCard from "../assets/landing/oferta-maestrias.jpg";
import doctorateCard from "../assets/landing/oferta-doctorados.jpg";

const programs = await getCollection("programas");
const sortPrograms = (items: typeof programs) =>
  [...items].sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "es", { sensitivity: "base" }),
  );
const licensePrograms = sortPrograms(
  programs.filter(({ data }) => data.nivel === "licenciaturas"),
);
const masterPrograms = sortPrograms(
  programs.filter(
    ({ data }) =>
      data.nivel === "posgrados" && data.categoria === "maestria",
  ),
);
const doctoratePrograms = sortPrograms(
  programs.filter(
    ({ data }) =>
      data.nivel === "posgrados" && data.categoria === "doctorado",
  ),
);
// The cards are portrait crops of landscape photos, so request enough source pixels for their height.
const offerImageSizes =
  "(max-width: 600px) 630px, (max-width: 800px) 540px, (max-width: 1920px) 76vw, 1455px";

const benefits = [
  {
    title: "Clases Virtuales",
    icon: "classroom",
    text: "SLS te permite tomar tus clases desde cualquier lugar con acceso a internet.",
  },
  {
    title: "Programas a 3 años",
    icon: "clock",
    text: "Licenciaturas en modalidad Live Streaming con una duración de 3 años.",
  },
  {
    title: "Libros LBS",
    icon: "book",
    text: "Toda la información de tu Licenciatura en un solo lugar y en cualquier lugar.",
  },
] as const;
---

<BaseLayout
  title="Inicio"
  description="Estudia licenciaturas en modalidad Live Streaming con Santander Live."
  footerSpacious
>
  <ParallaxHero
    image={hero}
    alt="Estudiante con audífonos y computadora"
    variant="home"
  >
    <div class="hero-copy">
      <h1>Tu licenciatura Nocturna<br />en tiempo real</h1><p>
        de 8:00 pm a 10:00 pm
      </p>
    </div>
  </ParallaxHero>
  <main id="contenido">
    <section
      class="benefit-section container"
      aria-label="Beneficios de Santander Live"
    >
      <div class="benefits">
        {
          benefits.map((item) => (
            <div class="benefit">
              <>
                <span class="benefit-symbol" aria-hidden="true">
                  <SiteIcon name={item.icon} />
                </span>
                <h2>{item.title}</h2>
                <p>{item.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </section>
    <section class="statement container">
      <p>Transformando la educación</p>
    </section>
    <section class="education">
      <div class="container education-grid">
        <Image
          src={student}
          alt="Estudiante con computadora portátil"
          widths={[480, 770, 1000]}
          sizes="(max-width: 800px) 100vw, 50vw"
          quality={85}
        />
        <div class="education-copy">
          <h2>Educación a <span>tu<br /> ritmo de vida</span></h2><ul>
            <li>Horario accesible</li><li>Contenidos digitales</li><li>
              Programas avalados por SEP
            </li><li>Clases virtuales en vivo</li><li>Grupos conformados</li>
          </ul><a class="button" href="#oferta">Ver oferta educativa</a>
        </div>
      </div>
    </section>
    <section class="lbs container" aria-labelledby="lbs-title">
      <div class="lbs-copy">
        <h2 id="lbs-title">Libros <span>LBS+</span></h2><p class="lbs-kicker">
          Todo en un Solo Lugar
        </p><p>
          LBS+ (Learning Bicultural System) es un sistema educativo que se apoya
          en el uso de la tecnología, a través una app propia, con libros
          digitales e interactivos basados en planes de estudio para nivel
          Licenciatura.
        </p><p>
          La app LBS+ es compatible con dispositivos móviles que cuenten con
          sistema operativo iOS y Android, al igual que está disponible para su
          uso en web.
        </p>
      </div>
      <div class="lbs-device">
        <Image
          src={laptop}
          alt="Computadora portátil del sistema LBS+"
          widths={[500, 900, 1300]}
          sizes="(max-width: 800px) 100vw, 50vw"
          quality={85}
        /><strong>LBS+</strong>
      </div>
    </section>
    <section id="oferta" class="offers container" aria-label="Oferta educativa">
      <article class="offer-card" data-open="false">
        <Image
          class="offer-image"
          src={licenseCard}
          alt="Estudiante universitaria trabajando en una computadora portátil"
          widths={[380, 650, 900]}
          sizes={offerImageSizes}
          quality={90}
        />
        <h2 class="offer-heading">
          <button
            class="offer-title"
            type="button"
            aria-expanded="false"
            aria-controls="offer-programs-licenciaturas"
          >Licenciaturas</button>
        </h2>
        <ul
          class="offer-programs"
          id="offer-programs-licenciaturas"
          aria-hidden="true"
          inert
        >
          {
            licensePrograms.map((program) => (
              <li>
                <a href={`/licenciaturas/${program.data.slug}`}>{program.data.title}</a>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="offer-card" data-open="false">
        <Image
          class="offer-image"
          src={postgraduateCard}
          alt="Estudiante trabajando con una computadora portátil"
          widths={[380, 650, 900, 1062]}
          sizes={offerImageSizes}
          quality={90}
        />
        <h2 class="offer-heading">
          <button
            class="offer-title"
            type="button"
            aria-expanded="false"
            aria-controls="offer-programs-maestrias"
          >Maestrías</button>
        </h2>
        <ul
          class="offer-programs"
          id="offer-programs-maestrias"
          aria-hidden="true"
          inert
        >
          {
            masterPrograms.map((program) => (
              <li>
                <a href={`/posgrados/${program.data.slug}`}>{program.data.title}</a>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="offer-card" data-open="false">
        <Image
          class="offer-image"
          src={doctorateCard}
          alt="Estudiante de doctorado trabajando frente a una computadora portátil"
          widths={[380, 650, 900, 1062]}
          sizes={offerImageSizes}
          quality={90}
        />
        <h2 class="offer-heading">
          <button
            class="offer-title"
            type="button"
            aria-expanded="false"
            aria-controls="offer-programs-doctorados"
          >Doctorados</button>
        </h2>
        <ul
          class="offer-programs"
          id="offer-programs-doctorados"
          aria-hidden="true"
          inert
        >
          {
            doctoratePrograms.map((program) => (
              <li>
                <a href={`/posgrados/${program.data.slug}`}>{program.data.title}</a>
              </li>
            ))
          }
        </ul>
      </article>
    </section>
    <ContactForm />
  </main>
</BaseLayout>

<style>
  .hero-copy {
    margin-top: 8rem;
    text-align: center;
    text-shadow: 0 2px 9px rgb(0 0 0 / 0.45);
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.2rem, 3.4vw, 4rem);
    line-height: 1.02;
    font-weight: 700;
  }
  .hero-copy p {
    margin: 0.35rem 0 0;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
  }
  .benefit-section {
    height: 0;
    position: relative;
    z-index: 2;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: min(800px, 100%);
    height: min(13vw, 250px);
    margin: auto;
    transform: translateY(-72%);
    background: var(--gray-100);
    color: #fff;
    box-shadow: 0 10px 25px rgb(0 0 0 / 0.12);
  }
  .benefit {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem 1.2rem 1.4rem;
    text-align: center;
  }
  .benefit + .benefit {
    border-left: 1px solid var(--gray-200);
  }
  .benefit-symbol {
    display: block;
    width: 40px;
    height: 40px;
    margin: 0 auto 0.65rem;
  }
  .benefit-symbol :global(svg),
  .benefit-symbol :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .benefit-symbol :global(svg) {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
  .benefit h2 {
    margin: 0 0 0.4rem;
    font-size: var(--text-card-title);
    font-weight: var(--weight-semibold);
  }
  .benefit p {
    max-width: 13rem;
    margin: auto;
    font-size: var(--text-caption);
    line-height: 1.4;
  }
  .statement {
    min-height: min(56.25vw, 1080px);
    display: grid;
    place-items: center;
    text-align: center;
  }
  .statement p {
    margin: 0;
    color: var(--gray-500);
    font-size: clamp(2rem, 3.4vw, 3.6rem);
    font-style: italic;
  }
  .education {
    background: var(--gray-950);
    overflow: hidden;
  }
  .education-grid {
    min-height: min(44.3vw, 850px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 4rem;
  }
  .education-grid :global(img) {
    width: min(100%, 670px);
    max-height: 620px;
    object-fit: contain;
    object-position: bottom;
  }
  .education-copy {
    align-self: center;
    transform: translateY(max(-5.2vw, -100px));
  }
  .education-copy h2 {
    margin: 0 0 1.3rem;
    font-size: clamp(2.25rem, 4.2vw, 4rem);
    line-height: 1.1;
  }
  .education-copy h2 span {
    color: var(--red-200);
  }
  .education-copy ul {
    padding-left: 1.2rem;
    line-height: 1.95;
    font-size: 0.94rem;
  }
  .education-copy .button {
    margin-top: 1rem;
  }
  .lbs {
    min-height: min(62vw, 1190px);
    display: grid;
    grid-template-columns: minmax(0, 47fr) minmax(0, 53fr);
    align-items: start;
    gap: 1rem;
  }
  .lbs-copy {
    margin-top: min(17vw, 330px);
    padding: 2rem;
    border-radius: 20px;
    box-shadow: 0 0 20px rgb(0 0 0 / 0.08);
  }
  .lbs-copy h2 {
    margin: 0;
    font-size: clamp(2.2rem, 3.7vw, 3.5rem);
    font-weight: 400;
  }
  .lbs-copy h2 span {
    color: var(--lbs-blue);
    font-weight: 700;
  }
  .lbs-kicker {
    margin-top: 0.25rem;
    font-weight: 600;
  }
  .lbs-copy p {
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .lbs-device {
    position: relative;
    margin-top: min(10vw, 190px);
  }
  .lbs-device :global(img) {
    width: 100%;
  }
  .lbs-device strong {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(3rem, 6vw, 6rem);
    white-space: nowrap;
  }
  .offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
    height: min(50.5vw, 970px);
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }
  .offer-card {
    --offer-title-height: 4rem;
    --offer-motion-duration: 460ms;
    --offer-motion-easing: cubic-bezier(0.22, 0.68, 0, 1);
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
  }
  .offer-heading {
    position: absolute;
    top: calc(100% - var(--offer-title-height));
    left: 0;
    right: 0;
    z-index: 2;
    height: var(--offer-title-height);
    margin: 0;
    transition: top var(--offer-motion-duration) var(--offer-motion-easing);
  }
  .offer-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .offer-title {
    width: 100%;
    height: 100%;
    border: 0;
    display: grid;
    padding: 0 1rem;
    place-items: center;
    background: rgb(204 0 51 / 0.93);
    color: #fff;
    text-align: center;
    font-family: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }
  .offer-title:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }
  .offer-programs {
    position: absolute;
    top: 100%;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.4rem 1rem;
    overflow: hidden;
    background: rgb(255 255 255 / 0.82);
    list-style: none;
    text-align: center;
    visibility: hidden;
    pointer-events: none;
    transition:
      top var(--offer-motion-duration) var(--offer-motion-easing),
      visibility 0s linear var(--offer-motion-duration);
  }
  .offer-card[data-open="true"] .offer-heading {
    top: 23%;
  }
  .offer-card[data-open="true"] .offer-programs {
    top: calc(23% + var(--offer-title-height));
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .offer-programs li {
    font-size: 0.75rem;
    line-height: 1.25;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 220ms var(--offer-motion-easing),
      transform 220ms var(--offer-motion-easing);
  }
  .offer-card[data-open="true"] .offer-programs li {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 90ms;
  }
  .offer-programs li a {
    text-decoration: none;
  }
  .offer-programs li a:hover,
  .offer-programs li a:focus-visible {
    color: var(--red-200);
  }
  @media (max-width: 800px) {
    .hero-copy {
      margin-top: 4rem;
    }
    .benefit-section {
      height: auto;
    }
    .benefits {
      width: 100%;
      height: auto;
      transform: none;
    }
    .statement {
      min-height: 370px;
    }
    .education-grid {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: 0;
    }
    .education-copy {
      grid-row: 1;
      padding: 4rem 0 2rem;
      transform: none;
    }
    .education-grid :global(img) {
      max-height: 430px;
      margin: auto;
    }
    .lbs {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
    .lbs-copy,
    .lbs-device {
      margin-top: 0;
    }
    .offers {
      gap: 0.8rem;
      height: auto;
    }
    .offer-card {
      --offer-title-height: 3.2rem;
      height: 360px;
    }
    .offer-title {
      font-size: 1.1rem;
    }
    .offer-programs {
      gap: 0.18rem;
      justify-content: safe center;
      overflow-y: auto;
      padding: 0.8rem 0.65rem;
    }
  }
  @media (max-width: 600px) {
    .hero-copy h1 {
      font-size: 2rem;
    }
    .benefits {
      grid-template-columns: 1fr;
    }
    .benefit + .benefit {
      border-left: 0;
      border-top: 1px solid var(--gray-200);
    }
    .benefit {
      padding: 0.8rem 1rem;
    }
    .benefit-symbol {
      width: 30px;
      height: 30px;
    }
    .statement {
      min-height: 300px;
    }
    .offers {
      grid-template-columns: 1fr;
    }
    .offer-card {
      height: 420px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .offer-heading,
    .offer-programs,
    .offer-programs li {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const offerCards = [
    ...document.querySelectorAll<HTMLElement>(".offer-card"),
  ];
  let hoveredOffer: HTMLElement | null = null;
  let focusedOffer: HTMLElement | null = null;
  let pinnedOffer: HTMLElement | null = null;
  let keyboardNavigation = false;

  const updateOfferState = () => {
    const activeOffer = focusedOffer ?? hoveredOffer ?? pinnedOffer;
    offerCards.forEach((offer) => {
      const isOpen = offer === activeOffer;
      offer.dataset.open = String(isOpen);
      offer
        .querySelector<HTMLButtonElement>(".offer-title")
        ?.setAttribute("aria-expanded", String(isOpen));
      const programs = offer.querySelector<HTMLUListElement>(".offer-programs");
      programs?.setAttribute("aria-hidden", String(!isOpen));
      if (programs) programs.inert = !isOpen;
    });
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === "Tab") keyboardNavigation = true;
  });

  document.addEventListener(
    "pointerdown",
    () => {
      keyboardNavigation = false;
      focusedOffer = null;
      updateOfferState();
    },
    true,
  );

  offerCards.forEach((offer) => {
    offer.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "touch") return;
      hoveredOffer = offer;
      updateOfferState();
    });

    offer.addEventListener("pointerleave", () => {
      if (hoveredOffer === offer) hoveredOffer = null;
      updateOfferState();
    });

    offer.addEventListener("focusin", () => {
      if (!keyboardNavigation) return;
      focusedOffer = offer;
      updateOfferState();
    });

    offer.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (offer.contains(document.activeElement)) return;
        if (focusedOffer === offer) focusedOffer = null;
        updateOfferState();
      });
    });

    offer.querySelector<HTMLButtonElement>(".offer-title")?.addEventListener("click", () => {
      pinnedOffer = pinnedOffer === offer ? null : offer;
      focusedOffer = null;
      updateOfferState();
    });
  });

  updateOfferState();
</script>
