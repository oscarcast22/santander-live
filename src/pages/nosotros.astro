---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import PageMotion from "../components/PageMotion.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ParallaxHero from "../components/ParallaxHero.astro";
import AboutAccordion from "../components/AboutAccordion.astro";
import BrandLogo from "../components/BrandLogo.astro";
import hero from "../assets/landing/hero-nosotros.jpg";
import banner from "../assets/banner-educacion.webp";

const institutional = await getEntry("institucional", "nosotros");
if (!institutional) throw new Error("Falta el contenido institucional de Nosotros.");
const model = await getEntry(institutional.data.model);
if (!model) throw new Error("Falta el modelo educativo de Nosotros.");
const items = [
  ...institutional.data.sections,
  { title: model.data.title, blocks: [{ paragraphs: model.data.paragraphs }] },
];
---

<BaseLayout
  title="Nosotros"
  description="Conoce Santander Live y la Universidad Autónoma de Durango."
>
  <PageMotion slot="head" profile="about" />
  <ParallaxHero
    image={hero}
    alt="Edificio de la Universidad Autónoma de Durango iluminado por la noche"
    variant="about"
  >
    <div class="about-hero-copy" data-page-reveal="hero">
      <BrandLogo
        context="hero"
        theme="light"
        alt="Santander Live Streaming y Universidad Autónoma de Durango"
      /><h1>Nosotros</h1>{
        institutional.data.history.map((paragraph) => <p>{paragraph}</p>)
      }
    </div>
  </ParallaxHero>
  <main id="contenido" data-page-motion>
    <div class="about-body container">
      <h2 data-page-reveal="block">NOSOTROS</h2><AboutAccordion items={items} /><Image
        src={banner}
        alt="Estudiante trabajando en una computadora"
        widths={[700, 1100, 1400]}
        sizes="(max-width: 800px) 100vw, 1270px"
        quality={85}
      />
    </div>
  </main>
</BaseLayout>
<style>
  .about-hero-copy {
    width: 100%;
    margin-top: 10rem;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.5);
  }
  .about-hero-copy :global(.brand-logo) {
    margin: 0 auto 2rem;
  }
  .about-hero-copy h1 {
    font-size: 1.6rem;
    font-weight: 600;
  }
  .about-hero-copy p {
    margin: 1rem 0;
    font-size: clamp(0.85rem, 1.15vw, 1.03rem);
    font-style: italic;
    line-height: 1.5;
  }
  .about-body {
    padding-top: 6rem;
    padding-bottom: 10rem;
  }
  .about-body h2 {
    margin: 0;
    font-size: clamp(2.5rem, 4vw, 4rem);
  }
  .about-body :global(img) {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }
  @media (max-width: 700px) {
    .about-hero-copy {
      margin-top: 4rem;
      max-height: 70svh;
      overflow: auto;
    }
    .about-hero-copy :global(.brand-logo) {
      display: none;
    }
    .about-hero-copy p {
      font-size: 0.77rem;
    }
    .about-body {
      padding-block: 4rem;
    }
  }
</style>
